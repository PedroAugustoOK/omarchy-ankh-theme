{
  "$schema": "vscode://schemas/color-theme",
  "name": "Omarchy Ankh",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": "#3A7082",
    "property": "#3A7082",
    "variable": "#243746",
    "function": "#2D5C86",
    "method": "#2D5C86",
    "class": "#8A6A2B",
    "interface": "#8A6A2B",
    "enum": "#8A6A2B",
    "type": "#8A6A2B",
    "typeParameter": "#8A6A2B",
    "string": "#3D765D",
    "number": "#9C5A38",
    "boolean": "#9C5A38",
    "operator": "#327A82",
    "keyword": "#466E92",
    "macro": "#327A82",
    "decorator": "#2D5C86",
    "comment": {
      "foreground": "#5F717D",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5F717D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#3D765D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#9C5A38"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#466E92"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#2D5C86"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#8A6A2B"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#327A82"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#243746"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#2D5C86"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5F717D"
      }
    }
  ],
  "colors": {
    "editor.foreground": "#243746",
    "editor.background": "#F4F6F8",
    "editorLineNumber.foreground": "#5F717D",
    "editorLineNumber.activeForeground": "#466E92",
    "editorCursor.foreground": "#466E92",
    "editor.lineHighlightBackground": "#E8EDF180",
    "editor.selectionBackground": "#DCE7F180",
    "activityBar.background": "#E8EDF1",
    "activityBar.foreground": "#243746",
    "activityBar.activeBorder": "#466E92",
    "sideBar.background": "#E8EDF1",
    "sideBar.foreground": "#243746",
    "sideBar.border": "#D5DEE6",
    "tab.activeBackground": "#F4F6F8",
    "tab.inactiveBackground": "#E8EDF1",
    "statusBar.background": "#466E92",
    "statusBar.foreground": "#F4F6F8",
    "titleBar.activeBackground": "#F4F6F8",
    "titleBar.activeForeground": "#243746",
    "editorError.foreground": "#A34B55",
    "editorWarning.foreground": "#8A6A2B",
    "editorInfo.foreground": "#2D5C86",
    "focusBorder": "#466E92"
  }
}
