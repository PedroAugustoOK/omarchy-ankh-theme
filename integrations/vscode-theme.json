{
  "$schema": "vscode://schemas/color-theme",
  "name": "Omarchy Ankh",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": "#638E99",
    "property": "#638E99",
    "variable": "#243746",
    "function": "#466E92",
    "method": "#466E92",
    "class": "#A98955",
    "interface": "#A98955",
    "enum": "#A98955",
    "type": "#A98955",
    "typeParameter": "#A98955",
    "string": "#668C77",
    "number": "#B97B67",
    "boolean": "#B97B67",
    "operator": "#638E99",
    "keyword": "#466E92",
    "macro": "#638E99",
    "decorator": "#466E92",
    "comment": {
      "foreground": "#5F717D",
      "fontStyle": "italic"
    }
  },
  "colors": {
    "editor.foreground": "#243746",
    "editor.background": "#F4F6F8",
    "editor.selectionBackground": "#DCE7F180",
    "editorError.foreground": "#B86B73",
    "editorWarning.foreground": "#A98955",
    "editorInfo.foreground": "#466E92",
    "focusBorder": "#466E92"
  }
}
