{
  "$schema": "vscode://schemas/color-theme",
  "name": "Omarchy Ankh",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": "#3A7082",
    "property": "#3A7082",
    "variable": "#243746",
    "function": "#2D5C86",
    "method": "#2D5C86",
    "class": "#8A6A2B",
    "interface": "#8A6A2B",
    "enum": "#8A6A2B",
    "type": "#8A6A2B",
    "typeParameter": "#8A6A2B",
    "string": "#3D765D",
    "number": "#9C5A38",
    "boolean": "#8E6428",
    "enumMember": "#8E6428",
    "variable.readonly": "#8E6428",
    "operator": "#327A82",
    "keyword": "#466E92",
    "macro": "#327A82",
    "decorator": "#2D5C86",
    "comment": {
      "foreground": "#5F717D",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5F717D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#3D765D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#9C5A38"
      }
    },
    {
      "scope": [
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#8E6428"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#466E92"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#2D5C86"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#8A6A2B"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#327A82"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#243746"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#3A7082"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#2D5C86"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5F717D"
      }
    }
  ],
  "colors": {
    "editor.foreground": "#243746",
    "editor.background": "#F4F6F8",
    "editorLineNumber.foreground": "#5F717D",
    "editorLineNumber.activeForeground": "#466E92",
    "editorCursor.foreground": "#466E92",
    "editor.lineHighlightBackground": "#E8EDF180",
    "editor.selectionBackground": "#DCE7F1",
    "activityBar.background": "#E8EDF1",
    "activityBar.foreground": "#243746",
    "activityBar.activeBorder": "#466E92",
    "sideBar.background": "#E8EDF1",
    "sideBar.foreground": "#243746",
    "sideBar.border": "#D5DEE6",
    "tab.activeBackground": "#F4F6F8",
    "tab.inactiveBackground": "#E8EDF1",
    "statusBar.background": "#466E92",
    "statusBar.foreground": "#F4F6F8",
    "titleBar.activeBackground": "#F4F6F8",
    "titleBar.activeForeground": "#243746",
    "editorError.foreground": "#A34B55",
    "editorWarning.foreground": "#8A6A2B",
    "editorInfo.foreground": "#2D5C86",
    "focusBorder": "#466E92",
    "foreground": "#243746",
    "descriptionForeground": "#5F717D",
    "disabledForeground": "#5F717D",
    "errorForeground": "#A34B55",
    "editor.selectionForeground": "#243746",
    "editor.inactiveSelectionBackground": "#DCE7F1",
    "list.activeSelectionBackground": "#DCE7F1",
    "list.activeSelectionForeground": "#243746",
    "list.inactiveSelectionBackground": "#DCE7F1",
    "list.inactiveSelectionForeground": "#243746",
    "list.focusBackground": "#DCE7F1",
    "list.focusForeground": "#243746",
    "list.hoverBackground": "#E8EDF1",
    "list.hoverForeground": "#243746",
    "list.highlightForeground": "#466E92",
    "activityBar.inactiveForeground": "#5F717D",
    "editorGroupHeader.tabsBackground": "#E8EDF1",
    "tab.activeForeground": "#243746",
    "tab.inactiveForeground": "#5F717D",
    "tab.activeBorderTop": "#466E92",
    "tab.border": "#E8EDF1",
    "titleBar.inactiveBackground": "#E8EDF1",
    "titleBar.inactiveForeground": "#5F717D",
    "panel.background": "#F4F6F8",
    "panel.border": "#D5DEE6",
    "panelTitle.activeForeground": "#243746",
    "panelTitle.inactiveForeground": "#5F717D",
    "panelTitle.activeBorder": "#466E92",
    "input.background": "#F4F6F8",
    "input.foreground": "#243746",
    "input.border": "#5F717D",
    "input.placeholderForeground": "#5F717D",
    "dropdown.background": "#E8EDF1",
    "dropdown.foreground": "#243746",
    "dropdown.border": "#5F717D",
    "button.background": "#466E92",
    "button.foreground": "#F4F6F8",
    "badge.background": "#466E92",
    "badge.foreground": "#F4F6F8",
    "statusBar.noFolderBackground": "#466E92",
    "statusBar.noFolderForeground": "#F4F6F8",
    "statusBar.debuggingBackground": "#466E92",
    "statusBar.debuggingForeground": "#F4F6F8",
    "editorWidget.background": "#E8EDF1",
    "editorWidget.foreground": "#243746",
    "editorWidget.border": "#5F717D",
    "editorSuggestWidget.background": "#E8EDF1",
    "editorSuggestWidget.foreground": "#243746",
    "editorSuggestWidget.selectedBackground": "#DCE7F1",
    "editorSuggestWidget.selectedForeground": "#243746",
    "editorSuggestWidget.highlightForeground": "#466E92",
    "menu.background": "#E8EDF1",
    "menu.foreground": "#243746",
    "menu.selectionBackground": "#DCE7F1",
    "menu.selectionForeground": "#243746",
    "notifications.background": "#E8EDF1",
    "notifications.foreground": "#243746",
    "terminal.background": "#F4F6F8",
    "terminal.foreground": "#243746",
    "editorBracketHighlight.foreground1": "#2D5C86",
    "editorBracketHighlight.foreground2": "#8A6A2B",
    "editorBracketHighlight.foreground3": "#3A7082",
    "editorBracketHighlight.foreground4": "#466E92",
    "editorBracketHighlight.foreground5": "#3D765D",
    "editorBracketHighlight.foreground6": "#9C5A38",
    "terminal.ansiBlack": "#F4F6F8",
    "terminal.ansiRed": "#B86B73",
    "terminal.ansiGreen": "#668C77",
    "terminal.ansiYellow": "#A98955",
    "terminal.ansiBlue": "#466E92",
    "terminal.ansiMagenta": "#897A98",
    "terminal.ansiCyan": "#638E99",
    "terminal.ansiWhite": "#486174",
    "terminal.ansiBrightBlack": "#5F717D",
    "terminal.ansiBrightRed": "#C47B82",
    "terminal.ansiBrightGreen": "#789C88",
    "terminal.ansiBrightYellow": "#B99A67",
    "terminal.ansiBrightBlue": "#6285A6",
    "terminal.ansiBrightMagenta": "#9A8BAB",
    "terminal.ansiBrightCyan": "#759FA8",
    "terminal.ansiBrightWhite": "#172A38",
    "editorHint.foreground": "#327A82"
  }
}
