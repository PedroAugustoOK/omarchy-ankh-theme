# Ankh companion configuration for git-delta.
# Include it from ~/.gitconfig instead of replacing existing Git settings:
#   [include]
#     path = /absolute/path/to/delta.gitconfig

[delta]
    features = ankh

[delta "ankh"]
    syntax-theme = ansi
    plus-style = syntax "#668C77"
    minus-style = syntax "#B86B73"
    zero-style = syntax "#5F717D"
    file-style = "#466E92" bold
    hunk-header-style = "#638E99" italic
    line-numbers = true
    line-numbers-minus-style = "#B86B73"
    line-numbers-plus-style = "#668C77"
